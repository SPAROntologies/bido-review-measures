  <rdf:Description rdf:about="http://purl.org/spar/bido/ConferenceRankingCategory">
    <rdfs:comment xml:lang="en">A category that can be used for ranking a conference according to the related ranking that defines it.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/spar/bido/CategorialBibliometricData"/>
    <rdfs:subClassOf rdf:nodeID="nbd63f21e4a8a477686b07e29b95e15b7b78"/>
    <rdfs:label xml:lang="en">conference ranking category</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns5:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:core-a .

    bido:core-a a bido:ConferenceRankingCategory .
    </vann:example>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
  </rdf:Description>
