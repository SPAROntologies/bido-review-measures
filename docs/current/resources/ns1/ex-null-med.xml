<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:ns1="http://purl.org/spar/bido/"
   xmlns:ns5="http://www.w3.org/2003/06/sw-vocab-status/ns#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="http://purl.org/spar/bido/ex-null-med">
    <rdfs:label xml:lang="en">Medium (Expert to Null reviewer confidence scale)</rdfs:label>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/ex-null-med"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/acl-1-5-acl3"/>
    <ns1:isDefinedIn rdf:resource="http://purl.org/spar/bido/ex-null"/>
    <vann:example>
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:ex-null-med .
    </vann:example>
    <rdfs:comment xml:lang="en">The value 'Medium' in a discrete scale from 'Expert' to 'Null' for rating reviewers' confidence.</rdfs:comment>
    <rdf:type rdf:resource="http://purl.org/spar/bido/ReviewerConfidenceValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns5:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <ns1:hasConfidenceValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</ns1:hasConfidenceValue>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
  </rdf:Description>
</rdf:RDF>
