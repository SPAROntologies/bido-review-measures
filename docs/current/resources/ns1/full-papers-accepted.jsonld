[
  {
    "@id": "http://purl.org/spar/bido/full-papers-accepted",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      {
        "@id": "_:nbd63f21e4a8a477686b07e29b95e15b7b28"
      },
      "http://purl.org/spar/bido/BibliometricMeasure"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-academic-event a swc:AcademicEvent ;\n        bido:holdsBibliometricDataInTime :my-bibliometric-data-in-time .\n\n    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;\n        tvc:atTime :my-time-interval ;\n        bido:accordingTo :my-organization ;\n        bido:withBibliometricData :my-numeric-bibliometric-data .\n\n    :my-numeric-bibliometric-data a bido:NumericBibliometricData ;\n        bido:hasMeasure bido:full-papers-accepted ;\n        bido:hasNumericValue \"30\"^^xsd:float .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A measure indicating how many full papers has been accepted for publication or presentation in the venue."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
