  <rdf:Description rdf:about="http://purl.org/spar/bido/average-of-reviews-per-paper">
    <rdfs:label>average number of reviews per paper</rdfs:label>
    <rdf:type rdf:nodeID="n5e9878dc7e394fe7ab6bcc4d77272fa0b1"/>
    <rdf:type rdf:resource="http://purl.org/spar/bido/BibliometricMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <vann:example>
    :my-academic-event a swc:AcademicEvent ;
        bido:holdsBibliometricDataInTime :my-bibliometric-data-in-time .

    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData :my-numeric-bibliometric-data .

    :my-numeric-bibliometric-data a bido:NumericBibliometricData ;
        bido:hasMeasure bido:average-of-reviews-per-paper ;
        bido:hasNumericValue "3.5"^^xsd:float .
    </vann:example>
    <rdfs:comment>A measure indicating how many reviewers has been used for each paper submitted to a venue.</rdfs:comment>
    <ns5:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
  </rdf:Description>
