@prefix ns1: <http://purl.org/spar/bido/> .
@prefix ns5: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:dis-0-5-4 a ns1:ReviewRatingValue,
        owl:NamedIndividual ;
    rdfs:label "4 out of 5 (Discrete 0 to 5 review rating scale)"@en ;
    ns1:hasRatingValue "4"^^xsd:int ;
    ns1:isDefinedIn ns1:dis-0-5 ;
    vann:example """
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:dis-0-5-4 .
    """ ;
    rdfs:comment "The value 4 in a discrete scale from 0 to 5 for review rating."@en ;
    rdfs:isDefinedBy <http://purl.org/spar/bido-review-measures/> ;
    ns5:term_status <http://purl.org/linked-data/registry#statusStable> ;
    skos:closeMatch ns1:a-na-wr-app,
        ns1:a-r-ts-acc,
        ns1:dis-n2-p2-pos1,
        ns1:sa-sr-bl-acc,
        ns1:sa-sr-nb-acc .

