@prefix ns1: <http://purl.org/spar/bido/> .
@prefix ns5: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .

ns1:a-r-ts-rej a ns1:ReviewRatingValue,
        owl:NamedIndividual ;
    rdfs:label "Reject (Accept to Reject, Two Strikes review rating scale)"@en ;
    ns1:isDefinedIn ns1:a-r-ts ;
    vann:example """
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:a-r-ts-rej .
    """ ;
    rdfs:comment "The value 'Reject' in a discrete scale from 'Accept' to 'Reject, Two Strikes' for review rating."@en ;
    rdfs:isDefinedBy <http://purl.org/spar/bido-review-measures/> ;
    ns5:term_status <http://purl.org/linked-data/registry#statusStable> ;
    skos:closeMatch ns1:a-na-wr-napp,
        ns1:dis-0-10-0,
        ns1:dis-0-5-0,
        ns1:dis-0-5-1,
        ns1:dis-n2-p2-neg1,
        ns1:dis-n2-p2-neg2,
        ns1:sa-sr-bl-rej,
        ns1:sa-sr-bl-srej,
        ns1:sa-sr-nb-rej,
        ns1:sa-sr-nb-srej .

