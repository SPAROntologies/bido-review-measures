@prefix ns1: <http://purl.org/spar/bido/> .
@prefix ns5: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .

ns1:isHigherThan a owl:ObjectProperty ;
    rdfs:label "is higher than"@en ;
    vann:example """
    bido:core-a a bido:ConferenceRankingCategory ;
        bido:isHigherThan bido:core-b .
    
    bido:core-b a bido:ConferenceRankingCategory .
    """ ;
    rdfs:comment "A relation between a ranking category and another that is less important."@en ;
    rdfs:domain ns1:CategorialBibliometricData ;
    rdfs:isDefinedBy <http://purl.org/spar/bido-review-measures/> ;
    rdfs:range ns1:CategorialBibliometricData ;
    owl:inverseOf ns1:isLowerThan ;
    ns5:term_status <http://purl.org/linked-data/registry#statusStable> .

