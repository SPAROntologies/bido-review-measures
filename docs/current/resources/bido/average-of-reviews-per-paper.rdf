<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/bido/average-of-reviews-per-paper">
    <rdf:type rdf:resource="http://purl.org/spar/bido/BibliometricMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b1"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <vann:example>
    :my-academic-event a swc:AcademicEvent ;
        bido:holdsBibliometricDataInTime :my-bibliometric-data-in-time .

    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData :my-numeric-bibliometric-data .

    :my-numeric-bibliometric-data a bido:NumericBibliometricData ;
        bido:hasMeasure bido:average-of-reviews-per-paper ;
        bido:hasNumericValue "3.5"^^xsd:float .
    </vann:example>
    <rdfs:comment>A measure indicating how many reviewers has been used for each paper submitted to a venue.</rdfs:comment>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:label>average number of reviews per paper</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b2">
    <owl:onProperty rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b8"/>
    <owl:allValuesFrom rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b3"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b8">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/withBibliometricData"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b5">
    <rdf:rest rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b6"/>
    <rdf:first rdf:resource="http://data.semanticweb.org/ns/swc/ontology#AcademicEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b3">
    <owl:allValuesFrom rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b4"/>
    <owl:onProperty rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b7">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/holdsBibliometricDataInTime"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b1">
    <owl:onProperty rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b9"/>
    <owl:allValuesFrom rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b2"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b6">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://purl.org/spar/fabio/Expression"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b4">
    <owl:unionOf rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b5"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
