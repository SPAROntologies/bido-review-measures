<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b57">
    <owl:allValuesFrom rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b58"/>
    <owl:onProperty rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b61"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b60">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://purl.org/spar/fabio/Expression"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/bido/submissions-sent-for-review">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://purl.org/spar/bido/BibliometricMeasure"/>
    <rdf:type rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b55"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
    :my-academic-event a swc:AcademicEvent ;
        bido:holdsBibliometricDataInTime :my-bibliometric-data-in-time .

    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData :my-numeric-bibliometric-data .

    :my-numeric-bibliometric-data a bido:NumericBibliometricData ;
        bido:hasMeasure bido:submissions-sent-for-review ;
        bido:hasNumericValue "200"^^xsd:float .
    </vann:example>
    <rdfs:comment xml:lang="en">The number of submitted papers assigned to reviewers for revision.</rdfs:comment>
    <rdfs:label xml:lang="en">number of submission sent for review</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b63">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/hasMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b56">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b57"/>
    <owl:onProperty rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b62"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b55">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b56"/>
    <owl:onProperty rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b63"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b62">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/withBibliometricData"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b58">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b59"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b59">
    <rdf:first rdf:resource="http://data.semanticweb.org/ns/swc/ontology#AcademicEvent"/>
    <rdf:rest rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b60"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b61">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/holdsBibliometricDataInTime"/>
  </rdf:Description>
