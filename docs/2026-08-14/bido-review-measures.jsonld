  {
    "@id": "http://purl.org/spar/bido/ReviewerConfidenceScale",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;\n        tvc:atTime :my-time-interval ;\n        bido:accordingTo :my-organization ;\n        bido:withBibliometricData bido:acl-1-5-acl1 .\n\n    bido:acl-1-5-acl1 a bido:ReviewerConfidenceValue ;\n        bido:isDefinedIn bido:acl-1-5 .\n\n    bido:acl-1-5 a bido:DiscreteReviewerConfidenceScale .\n\n    bido:DiscreteReviewerConfidenceScale rdfs:subClassOf bido:ReviewerConfidenceScale .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
