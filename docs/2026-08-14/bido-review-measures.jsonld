        "@value": "2026-09-13"
      }
    ],
    "http://purl.org/dc/terms/publisher": [
      {
        "@id": "https://ror.org/00wb4mk85"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/SPAROntologies/bido/blob/master/docs/cq.md"
      }
    ],
    "http://purl.org/ontology/bibo/doi": [
      {
        "@value": "https://doi.org/10.25504/FAIRsharing.d7f0a9"
      }
    ],
    "http://purl.org/ontology/bibo/status": [
      {
        "@id": "http://purl.org/ontology/bibo/status/published"
      }
    ],
    "http://purl.org/vocab/vann/changes": [
      {
        "@language": "en",
        "@value": "\n* **v1.2.1**: Added new documentation, including annotation properties (e.g., `bibo:doi`, `schema:codeRepository`, etc.), term properties (e.g., `vann:example`, `vs:term_status`, etc.), exemplary competency questions with their respective SPARQL queries, and a Grafoo diagram.\n* **v1.2.2**: Fixed `tvc:atTime` range, adding `time:TemporalEntity`.\n    "
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@language": "en",
        "@value": "bido"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@language": "en",
        "@value": "http://purl.org/spar/bido"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "BiDO Core module (BiDO-Core)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
