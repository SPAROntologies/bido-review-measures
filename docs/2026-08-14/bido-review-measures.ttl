    """ ;
    rdfs:comment "The value 2 in a discrete scale from 1 to 5 for review rating."@en ;
    rdfs:isDefinedBy : ;
    vs:term_status reg:statusStable ;
    skos:closeMatch bido:acl-1-5-acl2,
        bido:ex-null-low .

bido:acl-1-5-acl3 a bido:ReviewerConfidenceValue,
