    """ ;
    rdfs:comment "A continuous review rating scale, ranging from 0 to 15."@en ;
    rdfs:isDefinedBy : ;
    vs:term_status reg:statusStable .

bido:to-5-continuous a bido:ReviewRatingScale,
        owl:NamedIndividual ;
    rdfs:label "0 to 5 continuos review rating scale"@en ;
