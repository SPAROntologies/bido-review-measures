bido:ConferenceRankingCategory a owl:Class ;
    rdfs:label "conference ranking category"@en ;
    vann:example """
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
