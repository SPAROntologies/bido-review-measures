bido:dis-0-10-7 a bido:ReviewRatingValue,
        owl:NamedIndividual ;
    rdfs:label "7 out of 10 (Discrete 0 to 10 review rating scale)"@en ;
    bido:hasRatingValue "7"^^xsd:int ;
