<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/bido/PeerReviewType">
    <rdfs:subClassOf rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b71"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/spar/bido/CategorialBibliometricData"/>
    <rdfs:comment xml:lang="en">A type of of peer review process, such as 'double-blind' or 'open'.</rdfs:comment>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:double-blind-peer-review .

    :double-blind-peer-review a bido:PeerReviewType .
    </vann:example>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <rdfs:label xml:lang="en">peer review type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b73">
    <owl:unionOf rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b74"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b72">
    <owl:onProperty rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b76"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b73"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b74">
    <rdf:first rdf:resource="http://data.semanticweb.org/ns/swc/ontology#AcademicEvent"/>
    <rdf:rest rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b75"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b77">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/withBibliometricData"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b71">
    <owl:allValuesFrom rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b72"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b77"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b75">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://purl.org/spar/fabio/Expression"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3cff7311421d4dd39e9713bfd19183b7b76">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/holdsBibliometricDataInTime"/>
  </rdf:Description>
</rdf:RDF>
