    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "en",
        "@value": "\nThis module of BiDO describes a list of possible reviews measures that can be used to define bibliometric data of scholarly venues such as conferences, workshops, and journals.\n\n![The architecture of the BiDO-Review-Measures module.](bido-review-measures.png)\n"
      }
