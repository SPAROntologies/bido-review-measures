  {
    "@id": "http://purl.org/spar/bido/short-papers-accepted",
    "@type": [
      "http://purl.org/spar/bido/BibliometricMeasure",
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      {
        "@id": "_:n5e9878dc7e394fe7ab6bcc4d77272fa0b46"
      }
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-academic-event a swc:AcademicEvent ;\n        bido:holdsBibliometricDataInTime :my-bibliometric-data-in-time .\n\n    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;\n        tvc:atTime :my-time-interval ;\n        bido:accordingTo :my-organization ;\n        bido:withBibliometricData :my-numeric-bibliometric-data .\n\n    :my-numeric-bibliometric-data a bido:NumericBibliometricData ;\n        bido:hasMeasure bido:short-papers-accepted ;\n        bido:hasNumericValue \"35\"^^xsd:float .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A measure indicating how many short papers has been accepted for publication or presentation in the venue."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://purl.org/spar/bido-review-measures/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "number of short paper accepted"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
